# ============================================
# Paperboy - Configuración de Variables de Entorno
# ============================================
# Copia este archivo a .env y completa los valores

# ============================================
# Configuración del Servidor
# ============================================
NODE_ENV=production
PORT=10000

# ============================================
# Configuración de IA
# ============================================

# Clave API de Google Gemini (requerida para IA)
# Obtén tu clave en: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Proveedor de IA: 'gemini' o 'ollama'
VITE_AI_PROVIDER=gemini
AI_PROVIDER=gemini

# URL del backend (deja vacío para usar el mismo servidor)
VITE_BACKEND_URL=

# Configuración de Ollama (opcional - fallback si no usas Gemini)
VITE_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2
OLLAMA_MODEL=llama3.2
VITE_OLLAMA_API_KEY=
OLLAMA_API_KEY=
