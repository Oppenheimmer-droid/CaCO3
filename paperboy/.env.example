# ============================================
# Paperboy - Configuración de Variables de Entorno
# ============================================
# Copia este archivo a .env y completa los valores

# ============================================
# Configuración del Servidor
# ============================================
NODE_ENV=production
PORT=10000

# ============================================
# Configuración de IA
# ============================================

# Clave API de Groq (gratis, rápido)
# Obtén tu clave en: https://console.groq.com/keys
VITE_GROQ_API_KEY=
GROQ_API_KEY=

# Modelo de Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768, etc.
VITE_GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Clave API de Google Gemini (alternativa)
# Obtén tu clave en: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Proveedor de IA de texto: 'groq', 'gemini' o 'ollama'
VITE_AI_PROVIDER=groq
AI_PROVIDER=groq

# URL del backend (deja vacío para usar el mismo servidor)
VITE_BACKEND_URL=

# Configuración de Ollama (opcional - fallback si no usas Gemini)
VITE_OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3
OLLAMA_MODEL=llama3
VITE_OLLAMA_API_KEY=
OLLAMA_API_KEY=

# ============================================
# Configuración de Generación de Imágenes
# ============================================

# Proveedor de imágenes: 'fal' (predeterminado)
VITE_IMAGE_PROVIDER=fal
IMAGE_PROVIDER=fal

# Clave API de FAL.AI para generación de imágenes con Flux
# Obtén tu clave en: https://fal.ai/dashboard/keys
VITE_FAL_API_KEY=
FAL_API_KEY=

# Modelo de FAL (fal-ai/flux-pro recomendado para mejor calidad)
VITE_FAL_MODEL=fal-ai/flux-pro
FAL_MODEL=fal-ai/flux-pro
